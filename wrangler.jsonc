{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scatterhoard",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "LOBBIES", "class_name": "Lobby" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://triley98.github.io,http://127.0.0.1:5173,http://localhost:5173",
  },
}
