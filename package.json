{
  "name": "scatterhoard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "dev:online": "npm run build && wrangler dev --port 8787 --ip 127.0.0.1",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run --outdir .wrangler/deploy"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  }
}
